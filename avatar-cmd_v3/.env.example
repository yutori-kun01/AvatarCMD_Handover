# ============================================
# Avatar CMD v3 — Environment Variables
# ============================================
# Docker:  cp .env.example .env  → fill the REQUIRED values
# Local:   see README (apps/web/.env.local + packages/db/.env)

# --- REQUIRED ---
DB_PASSWORD="change-me-strong-db-password"
# openssl rand -base64 32
AUTH_SECRET=""
# openssl rand -hex 32  (encrypts SNS tokens at rest — do not change after first use)
ENCRYPTION_KEY=""
ADMIN_EMAIL="admin@avatar-cmd.local"
ADMIN_PASSWORD=""

# --- Database / Queue (local dev only; docker-compose builds these) ---
# DATABASE_URL="postgresql://avatar:avatar@localhost:5432/avatar_cmd?schema=public"
# REDIS_URL="redis://localhost:6379"      # unset → in-memory queue

# --- AI (Gemini). Unset → deterministic mock generation ---
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# --- Publishing ---
# dry-run (default): marks posts published without calling SNS
# live: uses stored SNS credentials / Chrome Empire
PUBLISH_MODE="dry-run"

# --- Scheduler / Worker ---
SCHEDULER_TICK_MS=30000
SCHEDULER_MAX_RETRIES=3
QUEUE_CONCURRENCY=2
# RUN_SCHEDULER=false   # disable the in-process scheduler
# RUN_WORKER=false      # schedule only; let another process consume the queue
# ACTIVITY_RETENTION_DAYS=90
# SPARK_THRESHOLD=0.05  # MoodEngine "intuition spark" probability

# --- Soul Engine ---
# AVATAR_DATA_DIR="/app/data/avatars"   # set automatically in Docker

# --- Knowledge scraper (SSRF guard) ---
# SSRF_ALLOWED_PORTS="80,443"

# --- Chrome Empire (docker compose --profile chrome) ---
CHROME_POOL_SIZE=3
CHROME_STEALTH=true

# --- Marketing blog (Ghost Content API). Unset → empty blog ---
GHOST_URL=""
GHOST_CONTENT_API_KEY=""

# --- SNS OAuth apps (used by integrations providers) ---
X_CLIENT_ID=""
X_CLIENT_SECRET=""
THREADS_APP_ID=""

# --- Traefik override (docker-compose.traefik.yml) ---
DOMAIN="your-domain.com"
# TRAEFIK_NETWORK="traefik-net"
# WEB_PORT=3333
