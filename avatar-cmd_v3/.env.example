# ============================================
# Avatar CMD v3 — Environment Variables
# ============================================

# --- Database ---
DATABASE_URL="postgresql://avatar:password@db:5432/avatar_cmd?schema=public"

# --- Auth (NextAuth v5) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://avatar-cmd.your-domain.com"

# --- Encryption ---
ENCRYPTION_KEY="generate-32-char-hex-key-for-aes256"
MASTER_KEY=""

# --- Docker / Traefik ---
DOMAIN="your-domain.com"
DB_PASSWORD="changeme-strong-password"

# --- Discord Bot ---
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_CLIENT_ID=""

# --- SNS OAuth: X (Twitter) ---
X_API_KEY=""
X_API_SECRET=""

# --- SNS OAuth: Threads ---
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# --- SNS OAuth: YouTube ---
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- SNS OAuth: Facebook / Instagram ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# --- SNS OAuth: LinkedIn ---
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- SNS: Bluesky ---
BLUESKY_HANDLE=""
BLUESKY_APP_PASSWORD=""

# --- SNS: WordPress ---
WORDPRESS_URL=""
WORDPRESS_API_KEY=""

# --- Payment ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Chrome Empire ---
CHROME_POOL_SIZE=3
CHROME_HEADLESS=true
CHROME_STEALTH=true
# PROXY_SERVER=""

# --- Redis ---
REDIS_URL="redis://redis:6379"

# --- Scheduler ---
SCHEDULER_TICK_MS=30000
SCHEDULER_MAX_RETRIES=3

# --- TypeSafe / Jev Decision Layer ---
TYPESAFE_API_KEY=""
JEV_MODEL="jev-1.13.0"
