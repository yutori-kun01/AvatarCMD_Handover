# ============================================
# Avatar CMD v3 — Environment Variables
# ============================================

# --- Database ---
# ホストは compose のサービス名 db。DB_USER / DB_PASSWORD と揃える。
DATABASE_URL="postgresql://avatar:changeme-strong-password@db:5432/avatar_cmd?schema=public"
DB_NAME="avatar_cmd"
DB_USER="avatar"
DB_PASSWORD="changeme-strong-password"

# --- Auth (NextAuth v5 / Auth.js) ---
# AUTH_SECRET が v5 の正式な名前。NEXTAUTH_SECRET も後方互換で読まれる。
#   openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Cloudflare Tunnel の Public hostname を https で指定する
AUTH_URL="https://avatar-cmd.your-domain.com"

# --- Seed (開発用の初期管理者) ---
# 未指定の場合、seed 実行時にランダム生成してコンソールに1度だけ表示する
SEED_ADMIN_EMAIL="admin@avatar-cmd.local"
SEED_ADMIN_PASSWORD=""

# --- Encryption ---
ENCRYPTION_KEY="generate-32-char-hex-key-for-aes256"
MASTER_KEY=""

# --- Cloudflare Tunnel ---
# Zero Trust ダッシュボード → Networks → Tunnels で作成したトンネルの
# コネクタトークン。Public hostname を http://web:3000 に向けておく。
# このトークンだけでトンネルに接続できるため、絶対にコミットしない。
TUNNEL_TOKEN=""

# --- Docker ---
DOMAIN="your-domain.com"

# --- Discord Bot ---
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_CLIENT_ID=""

# --- SNS OAuth: X (Twitter) ---
X_API_KEY=""
X_API_SECRET=""

# --- SNS OAuth: Threads ---
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# --- SNS OAuth: YouTube ---
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- SNS OAuth: Facebook / Instagram ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# --- SNS OAuth: LinkedIn ---
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- SNS: Bluesky ---
BLUESKY_HANDLE=""
BLUESKY_APP_PASSWORD=""

# --- SNS: WordPress ---
WORDPRESS_URL=""
WORDPRESS_API_KEY=""

# --- Payment ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Chrome Empire ---
CHROME_POOL_SIZE=3
CHROME_HEADLESS=true
CHROME_STEALTH=true
# PROXY_SERVER=""
# Playwright 同梱以外のブラウザを使う場合に指定する
# CHROMIUM_EXECUTABLE=""

# --- Redis / ジョブキュー (BullMQ) ---
# web が投入し、worker と chrome-empire が消費する。
REDIS_URL="redis://redis:6379"
# worker の同時実行数（AI生成・ナレッジ収集）
WORKER_CONCURRENCY=2
# chrome-empire の同時実行数。ブラウザ1つあたりのメモリが大きいので既定は1
BROWSER_CONCURRENCY=1

# --- Scheduler ---
# AutomationRule の cron と期限が来た予約投稿を評価する間隔
SCHEDULER_TICK_MS=30000
# false にするとスケジューラを止める（worker はジョブ処理のみ行う）
SCHEDULER_ENABLED=true
# ブラウザ投稿の結果が返らないまま PUBLISHING で残った Content を
# FAILED に倒すまでの時間
PUBLISHING_TIMEOUT_MS=900000
# ジョブのリトライ回数（BullMQ、指数バックオフ）
SCHEDULER_MAX_RETRIES=3
