# ============================================
# Avatar CMD v3 — 環境変数
# ============================================
# 通常は `bash scripts/setup-env.sh <公開URL>` で自動生成してください。
#
# ここに置くのは「サーバーの起動に必要な値」だけです。
# SNS の Client ID / Secret、アクセストークン、アプリパスワード、ログインCookie、
# AI（Claude / OpenAI / Gemini）の API キーなどは、ダッシュボードの「設定」画面から入力します（暗号化してDBに保存）。

# --- 公開URL（OAuth リダイレクトURI・メディア公開URLに使用。設定画面で上書き可） ---
APP_URL=https://avatar-cmd.example.com
DOMAIN=avatar-cmd.example.com

# --- 管理者ログイン（設定 > セキュリティ で変更可） ---
ADMIN_PASSWORD=

# --- 暗号鍵（openssl rand -hex 32）。変更・紛失すると保存済みの認証情報を復号できません ---
ENCRYPTION_KEY=
SESSION_SECRET=

# --- Database ---
DB_PASSWORD=
# ローカル開発（pnpm dev）用。Docker Compose では自動的に db コンテナへ接続します
DATABASE_URL=postgresql://avatar:<DB_PASSWORD>@localhost:5432/avatar_cmd?schema=public

# --- Worker ---
SCHEDULER_TICK_MS=15000
SCHEDULER_MAX_RETRIES=3

# --- 任意 ---
# WEB_PORT=3333                    # Traefik を使わない場合の公開ポート
# TRAEFIK_NETWORK=traefik-net      # 既存 Traefik のネットワーク名
# TRAEFIK_CERTRESOLVER=letsencrypt
# MEDIA_MAX_MB=512                 # アップロード上限
# GHOST_URL=https://ghost.example.com   # マーケティングサイトのブログ
# GHOST_CONTENT_API_KEY=
