{
  "name": "@avatar-cmd/chrome-empire",
  "version": "3.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/worker.bundle.cjs",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/worker.bundle.cjs --external:playwright --external:bullmq --external:ioredis",
    "check:operations": "tsx scripts/operations-check.mts"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "@avatar-cmd/queue": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.13.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
