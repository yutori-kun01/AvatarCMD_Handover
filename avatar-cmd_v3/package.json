{
  "name": "avatar-cmd",
  "version": "3.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev --filter=@avatar-cmd/web --filter=@avatar-cmd/worker",
    "dev:web": "turbo run dev --filter=@avatar-cmd/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @avatar-cmd/db db:generate",
    "db:push": "pnpm --filter @avatar-cmd/db db:push",
    "db:studio": "pnpm --filter @avatar-cmd/db db:studio",
    "clean": "turbo run clean && rimraf node_modules",
    "db:deploy": "pnpm --filter @avatar-cmd/db db:deploy",
    "test": "pnpm --filter @avatar-cmd/integrations test",
    "typecheck": "turbo run typecheck",
    "setup": "bash scripts/setup-env.sh",
    "db:migrate": "pnpm --filter @avatar-cmd/db db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
